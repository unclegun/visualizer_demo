    <script src="~/js/site.js"></script>

    <script>
        // Drag and drop functionality for dashboard
        document.addEventListener('DOMContentLoaded', function() {
            const container = document.getElementById('dashboardContainer');
            if (!container) return;

            const cards = Array.from(container.querySelectorAll('.draggable-card'));
            let draggedElement = null;
            let resizeElement = null;
            let initialWidth, initialHeight, initialX, initialY;

            // Load saved order
            loadOrder();

            // Add resize handles to each card
            cards.forEach(card => {
                const handle = document.createElement('div');
                handle.className = 'resize-handle';
                handle.style.cssText = 'position: absolute; bottom: 0; right: 0; width: 20px; height: 20px; cursor: nw-resize; background: rgba(0,0,0,0.1); opacity: 0.5;';
                card.appendChild(handle);
            });

            // Drag and drop for reordering
            cards.forEach(card => {
                card.draggable = true;
                card.addEventListener('dragstart', function(e) {
                    draggedElement = this;
                    this.style.opacity = '0.5';
                    e.dataTransfer.effectAllowed = 'move';
                });

                card.addEventListener('dragend', function(e) {
                    this.style.opacity = '';
                    draggedElement = null;
                    saveOrder();
                });

                card.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                });

                card.addEventListener('drop', function(e) {
                    e.preventDefault();
                    if (draggedElement && draggedElement !== this) {
                        const draggedIndex = Array.from(container.children).indexOf(draggedElement);
                        const targetIndex = Array.from(container.children).indexOf(this);

                        if (draggedIndex < targetIndex) {
                            container.insertBefore(draggedElement, this.nextSibling);
                        } else {
                            container.insertBefore(draggedElement, this);
                        }
                    }
                });
            });

            // Resize functionality
            container.addEventListener('mousedown', function(e) {
                if (e.target.classList.contains('resize-handle')) {
                    const card = e.target.parentElement;
                    if (card.classList.contains('selected-for-resize')) {
                        resizeElement = card;
                        const rect = resizeElement.getBoundingClientRect();
                        initialWidth = rect.width;
                        initialHeight = rect.height;
                        initialX = e.clientX;
                        initialY = e.clientY;
                        e.preventDefault();
                    }
                }
            });

            document.addEventListener('mousemove', function(e) {
                if (resizeElement) {
                    const deltaX = e.clientX - initialX;
                    const deltaY = e.clientY - initialY;
                    const newWidth = Math.max(200, initialWidth + deltaX);
                    const newHeight = Math.max(200, initialHeight + deltaY);
                    resizeElement.style.width = newWidth + 'px';
                    resizeElement.style.height = newHeight + 'px';
                }
            });

            document.addEventListener('mouseup', function() {
                if (resizeElement) {
                    saveOrder();
                    resizeElement = null;
                }
            });

            // Selection for resize
            container.addEventListener('click', function(e) {
                if (!e.target.closest('.resize-handle') && !e.target.closest('.card')) {
                    cards.forEach(card => {
                        card.classList.remove('selected-for-resize');
                        const handle = card.querySelector('.resize-handle');
                        if (handle) handle.style.opacity = '0.5';
                    });
                }
            });

            cards.forEach(card => {
                card.addEventListener('click', function(e) {
                    if (!e.target.classList.contains('resize-handle')) {
                        cards.forEach(c => {
                            c.classList.remove('selected-for-resize');
                            const handle = c.querySelector('.resize-handle');
                            if (handle) handle.style.opacity = '0.5';
                        });
                        this.classList.add('selected-for-resize');
                        const handle = this.querySelector('.resize-handle');
                        if (handle) handle.style.opacity = '1';
                    }
                });
            });

            // Reset layout
            document.getElementById('resetLayout').addEventListener('click', function() {
                const defaultOrder = ['card1', 'card2', 'card3', 'card4', 'card5', 'card6', 'card7', 'card8', 'card9', 'card10', 'card11', 'card12'];
                const sortedCards = defaultOrder.map(id => document.getElementById(id)).filter(card => card);
                sortedCards.forEach(card => {
                    container.appendChild(card);
                    card.style.width = '';
                    card.style.height = '';
                    card.classList.remove('selected-for-resize');
                    const handle = card.querySelector('.resize-handle');
                    if (handle) handle.style.opacity = '0.5';
                });
                localStorage.removeItem('dashboardOrder');
            });

            function saveOrder() {
                const order = Array.from(container.children)
                    .filter(child => child.classList.contains('draggable-card'))
                    .map(card => ({
                        id: card.id,
                        width: card.style.width,
                        height: card.style.height
                    }));
                localStorage.setItem('dashboardOrder', JSON.stringify(order));
            }

            function loadOrder() {
                const saved = localStorage.getItem('dashboardOrder');
                if (saved) {
                    const order = JSON.parse(saved);
                    order.forEach(item => {
                        const card = document.getElementById(item.id);
                        if (card) {
                            container.appendChild(card);
                            if (item.width) card.style.width = item.width;
                            if (item.height) card.style.height = item.height;
                        }
                    });
                }
            }
        });

        // Navigation functionality
        function showSection(sectionName, linkElement) {
            // Hide all sections
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.add('d-none');
            });

            // Show selected section
            document.getElementById(sectionName + '-section').classList.remove('d-none');

            // Update navigation
            document.querySelectorAll('.navbar-nav .nav-link').forEach(link => {
                link.classList.remove('active');
            });
            if (linkElement) {
                linkElement.classList.add('active');
            }
        }

        function navigateToFeature(featureId, linkElement) {
            showSection('documentation', document.querySelector('a[href="#documentation"]'));

            const target = document.getElementById(featureId);
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                target.classList.add('shadow');
                window.setTimeout(() => target.classList.remove('shadow'), 900);
            }

            return false;
        }

        // Chart filtering
        function filterCharts(type) {
            const cards = document.querySelectorAll('.draggable-card');
            cards.forEach(card => {
                if (type === 'all' || card.classList.contains('chart-type-' + type)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Grid toggle
        function toggleGrid() {
            const container = document.getElementById('dashboardContainer');
            container.classList.toggle('show-grid');
        }

        // Export layout
        function exportLayout() {
            const layout = {
                cards: Array.from(document.querySelectorAll('.draggable-card')).map(card => ({
                    id: card.id,
                    type: card.className.split(' ').find(cls => cls.startsWith('chart-type-')).replace('chart-type-', ''),
                    position: card.style.transform,
                    size: { width: card.style.width, height: card.style.height }
                }))
            };

            const dataStr = JSON.stringify(layout, null, 2);
            const dataUri = 'data:application/json;charset=utf-8,'+ encodeURIComponent(dataStr);

            const exportFileDefaultName = 'dashboard-layout.json';

            const linkElement = document.createElement('a');
            linkElement.setAttribute('href', dataUri);
            linkElement.setAttribute('download', exportFileDefaultName);
            linkElement.click();
        }

    </script>
