                            <li class="nav-item">
                                <a class="nav-link" href="#bar-charts" onclick="filterCharts('bar')">
                                    <i class="fas fa-chart-bar me-2 text-primary"></i>Bar Charts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#line-charts" onclick="filterCharts('line')">
                                    <i class="fas fa-chart-line me-2 text-success"></i>Line Charts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#pie-charts" onclick="filterCharts('pie')">
                                    <i class="fas fa-chart-pie me-2 text-warning"></i>Pie Charts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#advanced-charts" onclick="filterCharts('advanced')">
                                    <i class="fas fa-chart-area me-2 text-info"></i>Advanced Charts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#data-tables" onclick="filterCharts('table')">
                                    <i class="fas fa-table me-2 text-secondary"></i>Data Tables
                                </a>
                            </li>
                        </ul>

                        <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
                            <span>Features</span>
                        </h6>
                        <ul class="nav flex-column mb-2">
                            <li class="nav-item">
                                <a class="nav-link" href="#drag-drop" onclick="return navigateToFeature('drag-drop', this)">
                                    <i class="fas fa-arrows-alt me-2"></i>Drag & Drop
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#responsive" onclick="return navigateToFeature('responsive', this)">
                                    <i class="fas fa-mobile-alt me-2"></i>Responsive Design
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#animations" onclick="return navigateToFeature('animations', this)">
                                    <i class="fas fa-play-circle me-2"></i>Animations
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <main class="col-lg-9 col-xl-10 px-4 py-4" id="main-content">
                <!-- Dashboard Section -->
                <section id="dashboard-section" class="content-section">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="h2 mb-1">Interactive Dashboard</h1>
                            <p class="text-muted mb-0">Drag, resize, and customize your data visualizations</p>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary btn-sm" onclick="toggleGrid()">
                                <i class="fas fa-th me-1"></i>Toggle Grid
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" onclick="exportLayout()">
                                <i class="fas fa-download me-1"></i>Export Layout
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Tip:</strong> Click on any card to select it for resizing. Drag cards to reorder them.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>

                    <div id="dashboardContainer" class="dashboard-container">
                        <div class="draggable-card chart-type-bar" id="card1">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "bar", Title = "Sales by Category", Data = Model.BarData, Id = "barChart" })
                        </div>
                        <div class="draggable-card chart-type-pie" id="card2">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "pie", Title = "Sales Distribution", Data = Model.PieData, Id = "pieChart" })
                        </div>
                        <div class="draggable-card chart-type-line" id="card3">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "line", Title = "Monthly Sales Trend", Data = Model.LineData, Id = "lineChart" })
                        </div>
                        <div class="draggable-card chart-type-pie" id="card4">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "doughnut", Title = "Category Breakdown", Data = Model.DoughnutData, Id = "doughnutChart" })
                        </div>
                        <div class="draggable-card chart-type-table" id="card5">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "table", Title = "Raw Sales Data", Data = Model.SalesTableData, Id = "salesTable" })
                        </div>
                        <div class="draggable-card chart-type-pie" id="card6">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "pie", Title = "Project Status Distribution", Data = Model.ProjectStatuses, Id = "statusPieChart" })
                        </div>
                        <div class="draggable-card chart-type-advanced" id="card7">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "radar", Title = "Project Evaluation Metrics", Data = Model.RadarData, Id = "radarChart" })
                        </div>
                        <div class="draggable-card chart-type-advanced" id="card8">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "polarArea", Title = "Quarterly Performance", Data = Model.PolarData, Id = "polarChart" })
                        </div>
                        <div class="draggable-card chart-type-pie" id="card9">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "doughnut", Title = "Budget Allocation", Data = Model.BudgetAllocation, Id = "budgetDoughnut" })
                        </div>
                        <div class="draggable-card chart-type-line" id="card10">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "area", Title = "Monthly Spending Trend", Data = Model.SpendingTrend, Id = "spendingArea" })
                        </div>
                        <div class="draggable-card chart-type-bar" id="card11">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "horizontalBar", Title = "Category Expenses", Data = Model.BudgetAllocation, Id = "horizontalBar" })
                        </div>
                        <div class="draggable-card chart-type-advanced" id="card12">
                            @await Html.PartialAsync("_ChartPartial", new { Type = "scatter", Title = "Correlation Analysis", Data = Model.ScatterData, Id = "scatterChart" })
