                                            <h6>Sample Data Service</h6>
                                            <pre><code class="language-csharp">public interface IChartDataService
{
    ChartData GetSalesByCategory();
    ChartData GetMonthlyRevenue();
    (List&lt;string&gt;, List&lt;List&lt;string&gt;&gt;) GetSalesTable();
}

public class ChartDataService : IChartDataService
{
    private readonly ApplicationDbContext _context;

    public ChartDataService(ApplicationDbContext context)
    {
        _context = context;
    }

    public ChartData GetSalesByCategory()
    {
        var data = _context.Sales
            .GroupBy(s => s.Category)
            .Select(g => new {
                Category = g.Key,
                Total = g.Sum(s => s.Amount)
            })
            .ToList();

        return new ChartData {
            Labels = data.Select(d => d.Category).ToList(),
            Values = data.Select(d => d.Total).ToList()
        };
    }
}</code></pre>
