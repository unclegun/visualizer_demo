@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "ASP.NET Core Chart.js Visualizer";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASP.NET Core Chart.js Visualizer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css" rel="stylesheet">
</head>
<body>
    <!-- Modern Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-lg">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                <i class="fas fa-chart-line me-2"></i>
                <span class="fw-bold">Chart.js Visualizer</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#dashboard" onclick="showSection('dashboard', this)">
                            <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#documentation" onclick="showSection('documentation', this)">
                            <i class="fas fa-book me-1"></i>Documentation
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#examples" onclick="showSection('examples', this)">
                            <i class="fas fa-code me-1"></i>Code Examples
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#api" onclick="showSection('api', this)">
                            <i class="fas fa-cogs me-1"></i>API Reference
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Sandbox">
                            <i class="fas fa-flask me-1"></i>Sandbox Examples
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                    <button id="resetLayout" class="btn btn-outline-light btn-sm me-2" title="Reset Dashboard Layout">
