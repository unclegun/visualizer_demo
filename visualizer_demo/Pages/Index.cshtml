            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { position: 'top' },
            title: { display: true, text: 'Custom Chart' }
        },
        scales: {
            y: { beginAtZero: true }
        }
    }
};

