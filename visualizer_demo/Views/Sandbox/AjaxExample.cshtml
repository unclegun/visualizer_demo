@{
    ViewData["Title"] = "AJAX Sandbox";
}

<div class="container mt-4">
    <div class="sandbox-hero mb-4">
        <span class="badge text-bg-light border">Sandbox</span>
        <h1 class="h3 mt-3 mb-2">AJAX Sandbox</h1>
        <p class="mb-0 text-secondary">Send asynchronous requests and update content dynamically without refreshing the page.</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <bs-card header="AJAX Form Example" card-class="shadow-sm border-0">
                <form id="ajaxForm">
                    <div class="mb-3">
                        <label for="dataInput" class="form-label">Enter some data:</label>
                        <input type="text" class="form-control" id="dataInput" placeholder="Type something...">
                    </div>
                    <button type="submit" class="btn btn-primary">Send via AJAX</button>
                </form>

                <div id="result" class="mt-3"></div>
            </bs-card>

            <bs-card header="Dynamic Content Loading" card-class="shadow-sm border-0 mt-4">
                <button id="loadContent" class="btn btn-outline-success">Load Dynamic Content</button>
                <div id="dynamicContent" class="mt-3"></div>
            </bs-card>
        </div>

        <div class="col-lg-4">
            <bs-card header="AJAX Features" card-class="shadow-sm border-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Fetch API</li>
                    <li class="list-group-item">POST requests</li>
                    <li class="list-group-item">JSON handling</li>
                    <li class="list-group-item">Dynamic updates</li>
                    <li class="list-group-item">No page refresh</li>
                </ul>
            </bs-card>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-link ps-0">Back to Sandbox Home</a>
    </div>
</div>

@section Scripts {
    <script>
        // AJAX Form Submission
        document.getElementById('ajaxForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const dataInput = document.getElementById('dataInput').value;
            const resultDiv = document.getElementById('result');
            
            try {
                const response = await fetch('/Sandbox/GetData', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify({ data: dataInput })
                });
                
                const result = await response.json();
                
                resultDiv.innerHTML = `
                    <div class="alert alert-success">
                        <strong>Success!</strong><br>
                        Message: ${result.message}<br>
                        Received: ${result.receivedData.data}
                    </div>
                `;
            } catch (error) {
                resultDiv.innerHTML = `
                    <div class="alert alert-danger">
                        <strong>Error!</strong> ${error.message}
                    </div>
                `;
            }
        });

        // Dynamic Content Loading
        document.getElementById('loadContent').addEventListener('click', function() {
            const contentDiv = document.getElementById('dynamicContent');
            const timestamp = new Date().toLocaleTimeString();
            
            contentDiv.innerHTML = `
                <div class="alert alert-info">
                    <strong>Dynamic Content Loaded!</strong><br>
                    Timestamp: ${timestamp}<br>
                    This content was added without refreshing the page.
                </div>
            `;
        });
    </script>
}
