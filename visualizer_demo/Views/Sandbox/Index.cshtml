@{
    ViewData["Title"] = "Sandbox Home";
}

<div class="sandbox-page py-4">
    <div class="sandbox-hero mb-4">
        <span class="badge text-bg-light border">ASP.NET Core MVC</span>
        <h1 class="display-6 mt-3 mb-2">Sandbox Examples</h1>
        <p class="lead mb-0">Explore reusable patterns for forms, components, AJAX workflows, and custom Tag Helpers.</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm sandbox-feature-card">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Forms</h2>
                    <p class="text-secondary flex-grow-1">Reusable form controls, validation, and clean form composition.</p>
                    <a asp-action="Forms" class="btn btn-primary">Open Forms</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm sandbox-feature-card">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Partial Views</h2>
                    <p class="text-secondary flex-grow-1">Composable view fragments to keep UI modular and maintainable.</p>
                    <a asp-action="Partials" class="btn btn-primary">Open Partials</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm sandbox-feature-card">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">View Components</h2>
                    <p class="text-secondary flex-grow-1">Server-rendered UI blocks with isolated logic and strong reusability.</p>
                    <a asp-action="Components" class="btn btn-primary">Open Components</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm sandbox-feature-card">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">AJAX Examples</h2>
                    <p class="text-secondary flex-grow-1">Fetch-based requests and dynamic content updates without page reloads.</p>
                    <a asp-action="AjaxExample" class="btn btn-primary">Open AJAX</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm sandbox-feature-card">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Agent Selector</h2>
                    <p class="text-secondary flex-grow-1">Advanced multi-select accordion workflow with category summaries.</p>
                    <a asp-action="AgentSelector" class="btn btn-primary">Open Selector</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm sandbox-feature-card">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Tag Helper Docs</h2>
                    <p class="text-secondary flex-grow-1">In-app documentation for helper tags, attributes, and implementation patterns.</p>
                    <a asp-action="TagHelpers" class="btn btn-outline-primary">View Documentation</a>
                </div>
            </div>
        </div>
    </div>
</div>
