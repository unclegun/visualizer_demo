{
  "OutputDirectory": "llm-context",
  "MaxFileBytes": 262144,
  "SoftContextBytes": 786432,
  "MaxSummaryFileBytes": 16384,
  "EnableFrontendSummaries": false,
  "FrontendSummaryExtensions": [
    ".js",
    ".ts",
    ".tsx",
    ".jsx",
    ".css",
    ".scss",
    ".html"
  ],
  "BuiltInWhitelist": [
    "**/*.cs",
    "**/*.cshtml",
    "**/*.sql",
    "**/*.json",
    "**/*.config",
    "**/*.csproj",
    "**/*.props",
    "**/*.targets"
  ],
  "BuiltInIgnore": [
    "**/bin/**",
    "**/obj/**",
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/wwwroot/lib/**",
    "**/llm-context/**"
  ]
}