<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Template Markup Deviation (HTML/Razor)</Title>
      <Shortcut>devhtml</Shortcut>
      <Description>Reusable comment block for intentional markup deviations from template patterns.</Description>
      <Author>visualizer_demo</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>Section</ID>
          <ToolTip>Page/section identifier</ToolTip>
          <Default>examples-section</Default>
        </Literal>
        <Literal>
          <ID>Reason</ID>
          <ToolTip>Why structure diverges from template</ToolTip>
          <Default>Supports content grouping not covered by base template</Default>
        </Literal>
      </Declarations>
      <Code Language="HTML"><![CDATA[<!--
  TEMPLATE STRUCTURE DEVIATION
  Section: $Section$
  Reason: $Reason$
  Constraint: Preserve semantic headings and keyboard navigation.
-->]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
