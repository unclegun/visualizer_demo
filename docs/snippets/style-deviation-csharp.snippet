<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Template Convention Deviation (C#)</Title>
      <Shortcut>devcs</Shortcut>
      <Description>Reusable comment block for intentional C# convention/style deviations.</Description>
      <Author>visualizer_demo</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>Area</ID>
          <ToolTip>Class/member area</ToolTip>
          <Default>IndexModel</Default>
        </Literal>
        <Literal>
          <ID>Reason</ID>
          <ToolTip>Why this differs from template/backend conventions</ToolTip>
          <Default>Matches external contract requirements</Default>
        </Literal>
      </Declarations>
      <Code Language="csharp"><![CDATA[// TEMPLATE CONVENTION DEVIATION
// Area: $Area$
// Reason: $Reason$
// Follow-up: Re-evaluate when shared conventions are revised.
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
